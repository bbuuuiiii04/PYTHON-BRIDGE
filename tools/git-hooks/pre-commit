#!/usr/bin/env bash
# Optional local pre-commit gate for the agent documentation system.
#
# Enable (opt-in, version-controlled):   git config core.hooksPath tools/git-hooks
# Disable:                               git config --unset core.hooksPath
# Skip once:                             git commit --no-verify
#
# Blocks the commit if any of the three hard doc checkers fail. Runs the
# staleness checker as a non-blocking advisory. Fast (<1s) and zero-dependency.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PY="$(command -v python3 || true)"
if [[ -z "$PY" ]]; then
  echo "pre-commit: python3 not found; skipping doc checks (commit allowed)." >&2
  exit 0
fi

fail=0
for check in check_docs_metadata check_agent_contracts check_docs_drift; do
  if ! "$PY" "tools/${check}.py"; then
    fail=1
  fi
done

if [[ "$fail" -ne 0 ]]; then
  echo "" >&2
  echo "pre-commit: doc checks failed. Fix them, or bypass with: git commit --no-verify" >&2
  exit 1
fi

# Advisory only — never blocks OR WEDGES the commit (2026-07-09 fix: under
# multi-lane load the advisory step's per-file git-log fan-out ran for minutes
# and presented as a deadlock; 3+ incidents in one night). Three guards:
#  1. Foreign index.lock present => another lane is mid-commit; skip. (Verified:
#     our own commit does NOT hold index.lock while pre-commit runs, so this
#     can only fire on real contention.)
#  2. Hard 20s timeout => slow-crawl under CPU load skips instead of wedging.
#  3. GIT_OPTIONAL_LOCKS=0 => no child git takes opportunistic index locks.
if [[ -e "$(git rev-parse --git-dir)/index.lock" ]]; then
  echo "pre-commit: index contended (another lane mid-commit); skipping advisory staleness check — hard checks above already passed." >&2
else
  GIT_OPTIONAL_LOCKS=0 "$PY" - <<'PYEOF' || true
import subprocess, sys
try:
    subprocess.run([sys.executable, "tools/check_docs_staleness.py"], timeout=20)
except subprocess.TimeoutExpired:
    print("pre-commit: advisory staleness check timed out (20s, likely CPU/lock contention); skipped — hard checks already passed.", file=sys.stderr)
except Exception as e:
    print(f"pre-commit: advisory staleness check skipped ({e}); hard checks already passed.", file=sys.stderr)
PYEOF
fi

exit 0
